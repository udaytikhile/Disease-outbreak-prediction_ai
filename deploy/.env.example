# Disease Outbreak Prediction AI — Production Deployment
# Copy to .env in project root before running: docker compose -f deploy/docker-compose.yml up -d

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Google Gemini API key for symptom checker (optional but recommended)
GEMINI_API_KEY=

# Optional: Sentry DSN for error monitoring
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
